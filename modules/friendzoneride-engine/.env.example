# ── Fare rate bands (LKR per km per seat) ────────────────────────────────────
# Band 1: short routes  (up to FARE_BAND1_THRESHOLD_KM)
FARE_BAND1_THRESHOLD_KM=10
FARE_BAND1_RATE_MIN=10
FARE_BAND1_RATE_MAX=20

# Band 2: medium routes (BAND1 threshold up to FARE_BAND2_THRESHOLD_KM)
FARE_BAND2_THRESHOLD_KM=25
FARE_BAND2_RATE_MIN=8
FARE_BAND2_RATE_MAX=18

# Band 3: long routes   (above FARE_BAND2_THRESHOLD_KM)
FARE_BAND3_RATE_MIN=7
FARE_BAND3_RATE_MAX=15

# ── Comparison & discount ─────────────────────────────────────────────────────
# PickMe/Uber equivalent rate shown to passengers for comparison (LKR per km)
PICKME_RATE_PER_KM=72.5

# Full-week booking discount percentage (applied when booking_type=weekly, 5 days)
WEEKLY_DISCOUNT_PCT=17

# ── Matching ──────────────────────────────────────────────────────────────────
# Radius (km) within which a passenger's home location matches a route start
ROUTE_MATCH_RADIUS_KM=1.0
